DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro

TAVILY_API_KEY=
YOUTUBE_API_KEY=

SEARCH_PROVIDER=tavily_youtube

MAX_RESOURCES_PER_NODE=4
TARGET_RESOURCES_PER_NODE=3
MIN_RESOURCES_PER_NODE=2

ROADMAP_GENERATION_TIMEOUT_SECONDS=15
LINK_VALIDATION_TIMEOUT_SECONDS=3

ENABLE_LINK_VALIDATION=true
ENABLE_CACHE=true
ENABLE_DEMO_FALLBACK=true

SQLITE_DB_PATH=./lockedin_cache.db

ENVIRONMENT=development
LOG_FAILED_GENERATIONS=true

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
